# Clé API Claude (analyse des photos + rédaction de l'annonce)
ANTHROPIC_API_KEY=

# Génération des photos "Studio IA" : au moins une des deux clés
# Google Gemini (recommandé : excellent pour garder le vêtement identique)
GEMINI_API_KEY=
# Modèle Gemini : gemini-2.5-flash-image (rapide, ~0,04 €/photo) ou gemini-3-pro-image-preview (qualité max)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

PORT=3000
