{
  "manifest_version": 3,
  "name": "Vinted Studio – remplissage d'annonce",
  "version": "1.0.0",
  "description": "Remplit le formulaire « Vendre » de Vinted avec les annonces préparées dans Vinted Studio.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Vinted Studio", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.lu/*",
        "https://www.vinted.es/*",
        "https://www.vinted.it/*",
        "https://www.vinted.de/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
